{
  "name": "Sales Dashboard Theme",
  "dataColors": [
    "#4472C4",
    "#ED7D31",
    "#A5A5A5",
    "#FFC000",
    "#5B9BD5",
    "#70AD47",
    "#FF0000",
    "#9E480E"
  ],
  "background": "#2D1B6B",
  "foreground": "#FFFFFF",
  "tableAccent": "#7B3FBE",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#3D1F7A"
              }
            },
            "transparency": 10
          }
        ],
        "fontColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#7B3FBE"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#2D1B6B"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#C2185B"
              }
            },
            "transparency": 0
          }
        ],
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#4472C4"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#4472C4"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#FFD700"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    }
  }
}
